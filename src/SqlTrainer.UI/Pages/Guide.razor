@page "/guide"
@using SqlTrainer.UI.Components.Guide

<PageTitle>Anleitung - SQL-Trainer</PageTitle>

<MudText Typo="Typo.h3" GutterBottom="true">Anleitung</MudText>
<MudText Class="mb-8">So erstellst du eine eigene Übungsdatenbank und lädst sie in den SQL-Trainer hoch.</MudText>

<MudText Typo="Typo.h5" GutterBottom="true">Aufbau des Datenbankpakets</MudText>
<br />
<MudText Typo="Typo.body2" GutterBottom="true">
    Eine Übungsdatenbank wird als <b>eine ZIP-Datei</b> hochgeladen. Der Name der ZIP-Datei wird zum Namen der Datenbank,<br />
    aus <code>Name_der_Datenbank.zip</code> wird also die Datenbank <code>Name_der_Datenbank</code>.<br />
    Die ZIP-Datei muss genau diese vier Dateien enthalten:
</MudText>

<MudPaper Class="pa-4 my-4" Outlined="true">
    <pre>@PackageStructure</pre>
</MudPaper>

<MudGrid Class="mb-8">
    <MudItem xs="12" sm="6" md="3">
        <MudCard Style="height: 100%">
            <MudCardContent>
                <MudText Typo="Typo.h6">beschreibung.txt</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Beschreibung des Szenarios und der Tabellen.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Style="height: 100%">
            <MudCardContent>
                <MudText Typo="Typo.h6">er_diagramm.png</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">ER-Diagramm der Datenbank als PNG-Bild.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Style="height: 100%">
            <MudCardContent>
                <MudText Typo="Typo.h6">datenbank.sql</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">SQL-Skript, das die Tabellen anlegt und die Beispieldaten einfügt.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudCard Style="height: 100%">
            <MudCardContent>
                <MudText Typo="Typo.h6">aufgaben.txt</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">25 Aufgaben mit Hilfestellung und Musterlösung.</MudText>
            </MudCardContent>
        </MudCard>
    </MudItem>
</MudGrid>

<MudAlert Severity="Severity.Normal" ContentAlignment="HorizontalAlignment.Start">
    Die Dateien dürfen direkt im ZIP liegen oder in genau einem Unterordner (so entsteht es, wenn du unter Windows
    einen Ordner per Rechtsklick packst, siehe <a href="guide#windows">Schritt für Schritt unter Windows</a>).
    Groß- und Kleinschreibung der Dateinamen spielt keine Rolle. Die ZIP-Datei darf höchstens @MaxMegabytes MB groß sein.
</MudAlert>

<br />
<MudText Typo="Typo.h5" GutterBottom="true">Die Dateien im Detail</MudText>
<br />
<MudText Typo="Typo.body2">
    Alle Textdateien müssen in <b>UTF-8</b> gespeichert sein, damit Umlaute wie ä, ö und ü richtig angezeigt werden.<br />
    Ob die Zeilenenden im Windows- oder Linux-Format vorliegen, ist egal.
</MudText>

<br />
<MudText Typo="Typo.h6" GutterBottom="true">beschreibung.txt</MudText>
<MudText Typo="Typo.body2" GutterBottom="true">
    Ein kurzer Text, der den Lernenden erklärt, worum es in der Datenbank geht.<br />
    Bewährt hat sich dieser Aufbau: Titel in der ersten Zeile, danach das Szenario,<br />
    eine Liste der Tabellen und Hinweise zu Beziehungen und Datenformaten (z.&nbsp;B. wie ein Datum gespeichert ist).
</MudText>
<MudPaper Class="pa-4 my-4" Outlined="true">
    <pre style="white-space: pre-wrap">@DescriptionExample</pre>
</MudPaper>

<br />
<MudText Typo="Typo.h6" GutterBottom="true">er_diagramm.png</MudText>
<MudText Typo="Typo.body2" GutterBottom="true">
    Das ER-Diagramm zeigt alle Tabellen mit ihren Spalten und Beziehungen. Es muss ein echtes <b>PNG-Bild</b> sein;<br />
    eine umbenannte JPG- oder PDF-Datei funktioniert nicht. Achte auf eine gut lesbare Auflösung (ca. 800 Pixel Breite oder mehr).
</MudText>

<br />
<MudText Typo="Typo.h6" GutterBottom="true">datenbank.sql</MudText>
<MudText Typo="Typo.body2" GutterBottom="true">
    Das Skript wird mit <b>SQLite</b> ausgeführt und baut die komplette Datenbank auf. Es besteht immer aus vier Teilen,
    in genau dieser Reihenfolge:
</MudText>
<MudPaper Class="pa-4 my-4" Outlined="true">
    <pre>@SqlExample</pre>
</MudPaper>

<MudText Typo="Typo.subtitle1" Class="mt-6 mb-1"><b>Stolperfallen</b></MudText>
<MudText Typo="Typo.body2" Class="mb-4">
    Diese Punkte macht man leicht falsch, besonders wenn man SQL von MySQL, MariaDB oder Access kennt.
    Ein Fehler hier bedeutet, dass das Paket beim Hochladen abgelehnt wird oder die Musterlösungen falsche Ergebnisse liefern.
</MudText>

<SqlPitfall Number="1" Title="PRAGMA foreign_keys = ON; gehört in die erste Zeile"
            WrongLabel="So nicht (Zeile fehlt)" Wrong="@PitfallPragmaWrong" Right="@PitfallPragmaRight">
    SQLite prüft Fremdschlüssel <b>standardmäßig nicht</b>, anders als die meisten anderen Datenbanksysteme.
    Ohne diese Zeile kannst du z.&nbsp;B. einen Schüler in Klasse 99 einfügen, obwohl es Klasse 99 gar nicht gibt,
    und niemand bemerkt den Fehler. Später liefern JOIN-Aufgaben dann unerwartete Ergebnisse.
    Die Zeile muss ganz oben stehen, vor allen anderen Befehlen.
</SqlPitfall>

<SqlPitfall Number="2" Title="DROP TABLE IF EXISTS – und zwar rückwärts" Wrong="@PitfallDropWrong" Right="@PitfallDropRight">
    Mit <code>DROP TABLE IF EXISTS</code> am Anfang kannst du das Skript beim Testen beliebig oft ausführen:
    Ohne <code>DROP</code> scheitert der zweite Lauf („table already exists“), ohne <code>IF EXISTS</code> der erste
    („no such table“). Weil die Fremdschlüssel aktiv sind, müssen Tabellen, die auf andere <b>verweisen</b>, zuerst gelöscht
    werden. Lösche also in der <b>umgekehrten</b> Reihenfolge, in der du die Tabellen anlegst.
</SqlPitfall>

<SqlPitfall Number="3" Title="Erst die Daten, auf die verwiesen wird" Wrong="@PitfallInsertOrderWrong" Right="@PitfallInsertOrderRight">
    Ein Datensatz mit Fremdschlüssel darf erst eingefügt werden, wenn der Datensatz existiert, auf den er verweist.
    Füge also zuerst die Klassen ein, dann die Schüler. Sonst bricht das Skript mit „FOREIGN KEY constraint failed“ ab.
</SqlPitfall>

<SqlPitfall Number="4" Title="Kommazahlen mit Punkt, nicht mit Komma" Wrong="@PitfallDecimalWrong" Right="@PitfallDecimalRight">
    In SQL trennt das Komma die einzelnen Werte. Aus <code>12,50</code> werden deshalb <b>zwei</b> Werte (12 und 50).
    Im besten Fall bricht das Skript ab, im schlimmsten Fall landen die Zahlen in der falschen Spalte.
</SqlPitfall>

<SqlPitfall Number="5" Title="Datum als Text im Format JJJJ-MM-TT" Wrong="@PitfallDateWrong" Right="@PitfallDateRight">
    SQLite hat keinen eigenen Datumstyp. Nur im Format <code>JJJJ-MM-TT</code> sortieren <code>ORDER BY</code>,
    <code>&lt;</code>, <code>&gt;</code> und <code>BETWEEN</code> richtig und funktionieren Datumsfunktionen wie
    <code>strftime</code>. Im deutschen Format würde <code>'01.12.2024'</code> vor <code>'19.11.2024'</code> einsortiert.
    Uhrzeiten werden als <code>HH:MM</code> gespeichert.
</SqlPitfall>

<SqlPitfall Number="6" Title="Text in einfache Anführungszeichen" Wrong="@PitfallQuotesWrong" Right="@PitfallQuotesRight">
    Texte stehen in SQL in <b>einfachen</b> Anführungszeichen. Doppelte Anführungszeichen bedeuten einen Spaltennamen.
    Enthält ein Text selbst ein Apostroph, schreibst du es doppelt: <code>'O''Brien'</code>.
</SqlPitfall>

<SqlPitfall Number="7" Title="Kein CREATE DATABASE und kein USE" Wrong="@PitfallCreateDbWrong" Right="@PitfallCreateDbRight">
    Die Datenbank selbst legt der SQL-Trainer an. Das Skript beginnt direkt mit dem Löschen und Anlegen der Tabellen.
</SqlPitfall>

<MudText Typo="Typo.subtitle1" Class="mt-6 mb-1"><b>Datentypen</b></MudText>
<MudText Typo="Typo.body2" Class="mb-2">
    SQLite kennt im Wesentlichen nur drei Datentypen. So übersetzt du die gewohnten Typen:
</MudText>
<MudSimpleTable Dense="true" Outlined="true" Class="mb-4">
    <thead>
        <tr>
            <th>Gewohnt aus MySQL, Access …</th>
            <th>In SQLite</th>
            <th>Hinweis</th>
        </tr>
    </thead>
    <tbody>
        <tr>
            <td><code>INT AUTO_INCREMENT PRIMARY KEY</code></td>
            <td><code>INTEGER PRIMARY KEY</code></td>
            <td>Zählt automatisch hoch. Genau so schreiben, nicht <code>INT</code>.</td>
        </tr>
        <tr>
            <td><code>INT</code>, <code>SMALLINT</code>, <code>BIGINT</code></td>
            <td><code>INTEGER</code></td>
            <td></td>
        </tr>
        <tr>
            <td><code>DECIMAL(8,2)</code>, <code>FLOAT</code>, <code>DOUBLE</code></td>
            <td><code>REAL</code></td>
            <td>Werte mit Punkt schreiben: <code>12.50</code></td>
        </tr>
        <tr>
            <td><code>VARCHAR(50)</code>, <code>CHAR(10)</code></td>
            <td><code>TEXT</code></td>
            <td>Die Länge wird von SQLite nicht geprüft.</td>
        </tr>
        <tr>
            <td><code>DATE</code>, <code>DATETIME</code>, <code>TIME</code></td>
            <td><code>TEXT</code></td>
            <td><code>'2025-11-19'</code>, <code>'2025-11-19 14:30'</code>, <code>'14:30'</code></td>
        </tr>
        <tr>
            <td><code>BOOLEAN</code></td>
            <td><code>INTEGER</code></td>
            <td><code>1</code> für ja, <code>0</code> für nein</td>
        </tr>
        <tr>
            <td><code>ENUM('bar', 'karte')</code></td>
            <td><code>TEXT CHECK (zahlart IN ('bar', 'karte'))</code></td>
            <td></td>
        </tr>
    </tbody>
</MudSimpleTable>

<br />
<MudText Typo="Typo.h6" GutterBottom="true">aufgaben.txt</MudText>
<MudText Typo="Typo.body2" GutterBottom="true">
    Die Datei enthält <b>genau 25 Aufgaben</b>, davon <b>je 5</b> aus jedem der fünf Themenbereiche.<br />
    Jede Aufgabe steht in einem eigenen Block. Ein Block beginnt und endet mit einer Zeile <code>##</code>,<br />
    die fünf Felder stehen jeweils in einer eigenen Zeile und werden durch Zeilen mit <code>#</code> getrennt:
</MudText>
<MudPaper Class="pa-4 my-4" Outlined="true">
    <pre>@TaskExample</pre>
</MudPaper>

<MudSimpleTable Dense="true" Outlined="true" Class="mb-4">
    <thead>
        <tr>
            <th>Feld</th>
            <th>Inhalt</th>
        </tr>
    </thead>
    <tbody>
        <tr><td>Nr</td><td>Fortlaufende Nummer von 1 bis 25, jede Nummer nur einmal.</td></tr>
        <tr><td>Themenbereich</td><td>Einer der fünf Themen-Keys (siehe unten).</td></tr>
        <tr><td>Aufgabe</td><td>Die Aufgabenstellung, die die Lernenden sehen.</td></tr>
        <tr><td>Hilfestellung</td><td>Ein Tipp, der bei Bedarf angezeigt wird. Darf nicht leer sein.</td></tr>
        <tr><td>Musterlösung</td><td>Eine <code>SELECT</code>-Abfrage, die gegen <code>datenbank.sql</code> fehlerfrei läuft.</td></tr>
    </tbody>
</MudSimpleTable>

<MudText Typo="Typo.body2" GutterBottom="true">Diese Themen-Keys sind erlaubt:</MudText>
<MudSimpleTable Dense="true" Outlined="true" Class="mb-4">
    <thead>
        <tr>
            <th>Key in aufgaben.txt</th>
            <th>Anzeige in der App</th>
        </tr>
    </thead>
    <tbody>
        <tr><td><code>SELECT</code></td><td>SELECT</td></tr>
        <tr><td><code>AGGREGAT</code></td><td>Aggregatfunktionen</td></tr>
        <tr><td><code>JOIN</code></td><td>JOIN</td></tr>
        <tr><td><code>GRUPPIERUNG</code></td><td>GROUP BY</td></tr>
        <tr><td><code>SUBSELECT</code></td><td>Subselects</td></tr>
    </tbody>
</MudSimpleTable>

<MudAlert Severity="Severity.Warning" ContentAlignment="HorizontalAlignment.Start">
    Die Zeilen <code>##</code> und <code>#</code> dienen als Trennzeichen. Schreibe Aufgabe, Hilfestellung und
    Musterlösung deshalb jeweils in <b>eine Zeile</b> und verwende keine Zeile, die nur aus <code>#</code>-Zeichen besteht.
</MudAlert>

<br />
<MudText Typo="Typo.h5" GutterBottom="true" id="windows">Schritt für Schritt unter Windows</MudText>
<MudText Typo="Typo.body2" Class="mb-6">
    Die Bilder zeigen Windows 11 (24H2). Bei älteren Versionen heißen manche Menüpunkte etwas anders, das ist jeweils dabei angegeben.
</MudText>

<div class="guide-step">
    <MudAvatar Color="Color.Primary" Size="Size.Small">1</MudAvatar>
    <div class="guide-step-content">
        <MudText Typo="Typo.subtitle1"><b>Dateiendungen sichtbar machen</b></MudText>
        <MudText Typo="Typo.body2">
            Windows blendet Endungen wie <code>.txt</code> normalerweise aus. Dann entsteht schnell eine Datei
            <code>beschreibung.txt.txt</code> oder <code>datenbank.sql.txt</code>, die der SQL-Trainer nicht findet.
            Öffne den Ordner im <b>Explorer</b>, klicke oben in der Leiste auf <b>Anzeigen</b> → <b>Einblenden</b> und
            setze den Haken bei <b>Dateinamenerweiterungen</b>.
        </MudText>
        <figure class="guide-shot">
            <img src="_content/SqlTrainer.UI/guide/dateiendungen.png" alt="Explorer-Menü Anzeigen, Untermenü Einblenden, Eintrag Dateinamenerweiterungen mit Haken" />
            <figcaption>Explorer: Anzeigen → Einblenden → Dateinamenerweiterungen. (Windows 10: Reiter „Ansicht“ → Haken bei „Dateinamenerweiterungen“)</figcaption>
        </figure>
    </div>
</div>

<div class="guide-step">
    <MudAvatar Color="Color.Primary" Size="Size.Small">2</MudAvatar>
    <div class="guide-step-content">
        <MudText Typo="Typo.subtitle1"><b>Textdateien im Editor als UTF-8 speichern</b></MudText>
        <MudText Typo="Typo.body2">
            Schreibe <code>beschreibung.txt</code>, <code>datenbank.sql</code> und <code>aufgaben.txt</code> mit dem
            Windows-<b>Editor</b> (Notepad) oder einem Code-Editor, nicht mit Word. Wähle beim Speichern
            <b>Datei</b> → <b>Speichern unter</b> und achte unten im Fenster auf die <b>Codierung UTF-8</b>.
            Bei <code>datenbank.sql</code> stellst du außerdem den Dateityp auf <b>Alle Dateien (*.*)</b>,
            sonst hängt der Editor ein <code>.txt</code> an.
        </MudText>
        <figure class="guide-shot">
            <img src="_content/SqlTrainer.UI/guide/speichern-utf8.png" alt="Unterer Teil des Fensters Speichern unter: Dateityp Alle Dateien, Codierung UTF-8" />
            <figcaption>Editor: Datei → Speichern unter. Unten rechts die Codierung, bei .sql-Dateien zusätzlich der Dateityp.</figcaption>
        </figure>
    </div>
</div>

<div class="guide-step">
    <MudAvatar Color="Color.Primary" Size="Size.Small">3</MudAvatar>
    <div class="guide-step-content">
        <MudText Typo="Typo.subtitle1"><b>SQL-Skript und Musterlösungen testen</b></MudText>
        <MudText Typo="Typo.body2">
            Installiere den kostenlosen
            <MudLink Href="https://sqlitebrowser.org" Target="_blank" Typo="Typo.body2" Color="Color.Primary"><b>DB Browser for SQLite</b></MudLink>.
            Dort legst du mit <b>Neue Datenbank</b> eine Testdatei an (das Fenster zum Anlegen einer Tabelle einfach schließen),
            wechselst in den Reiter <b>SQL ausführen</b>, fügst den Inhalt von <code>datenbank.sql</code> ein und startest mit
            <kbd>F5</kbd>. Danach probierst du dort jede Musterlösung aus.
            So findest du Fehler, bevor du die Datenbank hochlädst.
        </MudText>
    </div>
</div>

<div class="guide-step">
    <MudAvatar Color="Color.Primary" Size="Size.Small">4</MudAvatar>
    <div class="guide-step-content">
        <MudText Typo="Typo.subtitle1"><b>ZIP-Datei erstellen</b></MudText>
        <MudText Typo="Typo.body2">
            Lege die vier Dateien in einen Ordner und benenne ihn so, wie die Datenbank heißen soll (z.&nbsp;B. <code>Schule</code>).
            Mache einen <b>Rechtsklick</b> auf den Ordner und wähle <b>Komprimieren in…</b> → <b>ZIP-Datei</b>.
            Daneben entsteht <code>Schule.zip</code>.
        </MudText>
        <figure class="guide-shot">
            <img src="_content/SqlTrainer.UI/guide/zip-erstellen.png" alt="Kontextmenü des Ordners Schule mit Komprimieren in und Untermenü ZIP-Datei" />
            <figcaption>Rechtsklick auf den Ordner → Komprimieren in → ZIP-Datei. (Ältere Windows-11-Versionen: „In ZIP-Datei komprimieren“; Windows 10: „Senden an“ → „ZIP-komprimierter Ordner“)</figcaption>
        </figure>
    </div>
</div>

<div class="guide-step">
    <MudAvatar Color="Color.Primary" Size="Size.Small">5</MudAvatar>
    <div class="guide-step-content">
        <MudText Typo="Typo.subtitle1"><b>Hochladen</b></MudText>
        <MudText Typo="Typo.body2">
            Öffne die Seite
            <MudLink Href="datenbanken-verwalten" Typo="Typo.body2" Color="Color.Primary"><b>Datenbanken verwalten</b></MudLink>,
            klicke auf „Datenbank hochladen“ und wähle die ZIP-Datei aus. Gibt es schon eine Datenbank mit dem gleichen Namen,
            wirst du gefragt, ob sie ersetzt werden soll.
        </MudText>
        <figure class="guide-shot">
            <img src="_content/SqlTrainer.UI/guide/hochladen.png" alt="Seite Datenbanken verwalten mit markiertem Button Datenbank hochladen" />
            <figcaption>Menü links: Datenbanken verwalten → Datenbank hochladen.</figcaption>
        </figure>
    </div>
</div>

<MudCard Class="mb-4 mt-6">
    <MudCardContent>
        <MudText Typo="Typo.h6" GutterBottom="true">Checkliste vor dem Hochladen</MudText>
        <MudText Typo="Typo.body2">
            ✔ Alle vier Dateien sind vorhanden und genau so benannt wie oben (kein <code>.txt.txt</code>).<br />
            ✔ Alle Textdateien sind in UTF-8 gespeichert.<br />
            ✔ <code>datenbank.sql</code> beginnt mit <code>PRAGMA foreign_keys = ON;</code> und läuft in SQLite ohne Fehler durch, auch zweimal hintereinander.<br />
            ✔ <code>aufgaben.txt</code> enthält 25 Aufgaben, je 5 pro Themenbereich.<br />
            ✔ Jede Musterlösung liefert gegen die Beispieldaten ein sinnvolles Ergebnis.<br />
            ✔ Das ER-Diagramm passt zu den Tabellen in <code>datenbank.sql</code>.
        </MudText>
    </MudCardContent>
</MudCard>

@code {
    private const int MaxMegabytes = 50;

    private const string PackageStructure =
        """
        Name_der_Datenbank.zip
        ├── beschreibung.txt   Beschreibung der Datenbank und des Szenarios
        ├── er_diagramm.png    ER-Diagramm als PNG
        ├── datenbank.sql      SQL-Skript: Tabellen erstellen + Beispieldaten einfügen
        └── aufgaben.txt       25 Aufgaben inkl. Hilfestellungen und Musterlösungen
        """;

    private const string DescriptionExample =
        """
        Datenbank Schule

        In dieser Datenbank werden die Daten von einem Berufskolleg verwaltet. Es gibt Klassen, Lehrer, Schüler, Fächer und Noten.

        Tabellen:
        - lehrer: die Lehrer mit Name und Kürzel
        - klasse: die Klassen mit Bezeichnung, Raum und Klassenlehrer
        - schueler: die Schüler mit Geburtsdatum und Klasse

        Eine Klasse hat mehrere Schüler. Das Datum ist im Format JJJJ-MM-TT gespeichert.
        """;

    private const string SqlExample =
        """
        -- 1. Fremdschlüssel-Prüfung einschalten (siehe Stolperfalle 1)
        PRAGMA foreign_keys = ON;

        -- 2. Alte Tabellen löschen: abhängige Tabellen zuerst (siehe Stolperfalle 2)
        DROP TABLE IF EXISTS schueler;
        DROP TABLE IF EXISTS klasse;

        -- 3. Tabellen anlegen: Tabellen ohne Fremdschlüssel zuerst
        CREATE TABLE klasse (
          klasse_id INTEGER PRIMARY KEY,
          bezeichnung TEXT NOT NULL UNIQUE,
          raum TEXT NOT NULL
        );

        CREATE TABLE schueler (
          schueler_id INTEGER PRIMARY KEY,
          vorname TEXT NOT NULL,
          nachname TEXT NOT NULL,
          geburtsdatum TEXT NOT NULL,
          klasse_id INTEGER NOT NULL,
          FOREIGN KEY (klasse_id) REFERENCES klasse(klasse_id)
        );

        -- 4. Beispieldaten einfügen, in derselben Reihenfolge wie beim Anlegen
        INSERT INTO klasse VALUES
        (1, 'FI24A', 'A101'),
        (2, 'FI24B', 'A102');

        INSERT INTO schueler VALUES
        (1, 'Leon', 'Arslan', '2008-04-19', 1),
        (2, 'Marie', 'Becker', '2007-09-05', 2);
        """;

    private const string PitfallPragmaWrong =
        """
        DROP TABLE IF EXISTS schueler;
        DROP TABLE IF EXISTS klasse;
        ...
        """;

    private const string PitfallPragmaRight =
        """
        PRAGMA foreign_keys = ON;

        DROP TABLE IF EXISTS schueler;
        DROP TABLE IF EXISTS klasse;
        ...
        """;

    private const string PitfallDropWrong =
        """
        DROP TABLE klasse;
        DROP TABLE schueler;
        """;

    private const string PitfallDropRight =
        """
        DROP TABLE IF EXISTS schueler; -- verweist auf klasse
        DROP TABLE IF EXISTS klasse;
        """;

    private const string PitfallInsertOrderWrong =
        """
        INSERT INTO schueler VALUES
        (1, 'Leon', 'Arslan', '2008-04-19', 1);

        INSERT INTO klasse VALUES
        (1, 'FI24A', 'A101');
        """;

    private const string PitfallInsertOrderRight =
        """
        INSERT INTO klasse VALUES
        (1, 'FI24A', 'A101');

        INSERT INTO schueler VALUES
        (1, 'Leon', 'Arslan', '2008-04-19', 1);
        """;

    private const string PitfallDecimalWrong =
        """
        INSERT INTO artikel VALUES
