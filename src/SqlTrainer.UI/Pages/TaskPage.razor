<!-- Example Url: localhost:{yourPort}/tasks/Kino (1)/select/1 -->
@page "/tasks/{DatabaseName}/{TaskType}/{TaskNr:int}"
@inherits ViewModelComponentBase<TaskViewModel>

<PageTitle>@(Details is null ? "Aufgabe" : $"Aufgabe {Details.Exercise.Number} - {Details.DatabaseName}")</PageTitle>

@if (ViewModel.ErrorMessage is not null)
{
    <MudAlert Severity="Severity.Error" Style="white-space:pre-line;">@ViewModel.ErrorMessage</MudAlert>
}
else if (ViewModel.IsNotFound)
{
    <MudAlert Severity="Severity.Warning">
        Die Aufgabe @TaskNr im Themenbereich „@TaskType“ der Datenbank „@DatabaseName“ wurde nicht gefunden.
    </MudAlert>
}
else if (Details is null)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
}
else
{
    var exercise = Details.Exercise;

    @* Header *@
    <div class="d-flex justify-space-between align-start mb-6">
        <div>
            <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700; letter-spacing:.1em;">
                @Details.DatabaseName · @ViewModel.TopicDisplayName · Aufgabe @ViewModel.Position von @ViewModel.TopicExerciseCount
            </MudText>
            <MudText Typo="Typo.h4" Style="font-weight:700;">Aufgabe @exercise.Number</MudText>
        </div>
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack">
            Aufgabenübersicht
        </MudButton>
    </div>

    @if (ViewModel.IsLoading)
    {
        <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mb-2" />
    }

    @* Main three-column panel *@
    <MudPaper Outlined="true" Class="overflow-hidden">
        <div class="d-flex flex-wrap" style="min-height:600px;">

            @* Left: table structure *@
            @if (!_showLeftPanel)
            {
                <div class="pa-1 d-flex flex-column align-center" style="flex:0 0 48px; border-right:1px solid var(--mud-palette-divider);">
                    <MudTooltip Text="Tabellenstruktur anzeigen">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => _showLeftPanel = true)" aria-label="Tabellenstruktur anzeigen" />
                    </MudTooltip>
                    <MudText Typo="Typo.caption" Style="writing-mode:vertical-rl; transform:rotate(180deg); font-weight:600; cursor:pointer;"
                             Class="mt-2" @onclick="@(() => _showLeftPanel = true)">Tabellenstruktur</MudText>
                </div>
            }
            else
            {
            <div class="pa-4" style="flex:0 0 220px; border-right:1px solid var(--mud-palette-divider);">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Tabellenstruktur</MudText>
                    <MudTooltip Text="Einklappen">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small"
                                       OnClick="@(() => _showLeftPanel = false)" aria-label="Tabellenstruktur einklappen" />
                    </MudTooltip>
                </div>
                @foreach (var table in Details.Tables)
                {
                    var expanded = _expandedTables.Contains(table.Name);
                    <div class="mb-3">
                        <MudLink Color="Color.Primary" Typo="Typo.body2" Style="font-weight:600; cursor:pointer;"
                                 OnClick="@(() => ToggleTable(table.Name))">
                            <MudIcon Icon="@(expanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                                     Size="Size.Small" Style="vertical-align:middle;" />
                            @table.Name
                        </MudLink>
                        @if (expanded)
                        {
                            <div class="ml-3 mt-2 pl-4" style="border-left:1px solid var(--mud-palette-divider);">
                                @foreach (var column in table.Columns)
                                {
                                    <div class="mb-2">
                                        <MudText Typo="Typo.body2" Style="font-family:monospace;">@column.Name</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@DescribeColumn(column)</MudText>
                                    </div>
                                }
                            </div>
                        }
                        <MudDivider Class="mt-3" />
                    </div>
                }
            </div>
            }

            @* Middle: task, editor, result *@
            <div class="d-flex flex-column" style="flex:1 1 400px; min-width:0;">
                <div class="pa-4">
                    <div class="d-flex justify-space-between align-center">
                        <MudText Typo="Typo.overline" Color="Color.Primary" Style="font-weight:700; letter-spacing:.1em;">Deine Aufgabe</MudText>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowForward"
                                   OnClick="@(() => ViewModel.OpenErDiagramAsync())">
                            Datenmodell ansehen
                        </MudButton>
                    </div>
                    <MudText Typo="Typo.body1" Style="white-space:pre-line;">@exercise.Text</MudText>
                </div>
                <MudDivider />

                <div class="pa-4">
                    <MudText Typo="Typo.subtitle2" Style="font-weight:700;" Class="mb-3">SQL-Editor</MudText>
                    <textarea @bind="ViewModel.SqlQuery" @bind:event="oninput" spellcheck="false"
                              placeholder="Schreibe hier deine SQL-Abfrage …"
                              style="width:100%; height:280px; resize:vertical; padding:20px; border:none; border-radius:8px; outline:none;
                                     background:#1f2230; color:#e6e6f0; font-family:monospace; font-size:15px;"></textarea>
                    <div class="d-flex justify-end gap-2 mt-2">
                        <MudButton Variant="Variant.Text" OnClick="ViewModel.ClearQuery">Leeren</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ViewModel.CheckQuery">Abfrage überprüfen</MudButton>
                    </div>
                    <div class="d-flex gap-2 mt-2">
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" OnClick="ViewModel.ToggleHint"
                                   Disabled="string.IsNullOrWhiteSpace(exercise.Hint)">
                            @(ViewModel.ShowHint ? "Tipp ausblenden" : "Tipp anzeigen")
                        </MudButton>
                        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="ViewModel.ToggleSolution">
                            @(ViewModel.ShowSolution ? "Musterlösung ausblenden" : "Musterlösung anzeigen")
                        </MudButton>
                    </div>
                    @if (ViewModel.ShowHint)
                    {
                        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" Style="white-space:pre-line;">@exercise.Hint</MudAlert>
                    }
                    @if (ViewModel.ShowSolution)
                    {
                        <MudAlert Severity="Severity.Normal" Dense="true" Class="mt-2">
                            <pre style="margin:0; white-space:pre-wrap;"><code>@exercise.SampleSolution</code></pre>
                        </MudAlert>
                    }
                </div>
                <MudDivider />

                <div class="pa-4 flex-grow-1">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Ergebnis &amp; Rückmeldung</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">Demo-Prüfung</MudChip>
                    </div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @(ViewModel.ResultMessage ?? "Dein Ergebnis erscheint hier, sobald du die Abfrage überprüfst.")
                    </MudText>
                </div>
            </div>

            @* Right: sample data *@
            @if (!_showRightPanel)
            {
                <div class="pa-1 d-flex flex-column align-center" style="flex:0 0 48px; border-left:1px solid var(--mud-palette-divider);">
                    <MudTooltip Text="Beispieldaten anzeigen">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" Color="Color.Primary"
                                       OnClick="@(() => _showRightPanel = true)" aria-label="Beispieldaten anzeigen" />
                    </MudTooltip>
                    <MudText Typo="Typo.caption" Style="writing-mode:vertical-rl; font-weight:600; cursor:pointer;"
                             Class="mt-2" @onclick="@(() => _showRightPanel = true)">Beispieldaten</MudText>
                </div>
            }
            else
            {
            <div class="pa-4" style="flex:0 0 340px; min-width:0; border-left:1px solid var(--mud-palette-divider);">
                <div class="d-flex justify-space-between align-center mb-3">
                    <MudText Typo="Typo.subtitle1" Style="font-weight:700;">Verfügbare Beispieldaten</MudText>
                    <MudTooltip Text="Einklappen">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small"
                                       OnClick="@(() => _showRightPanel = false)" aria-label="Beispieldaten einklappen" />
                    </MudTooltip>
                </div>
                @foreach (var table in Details.Tables)
                {
                    var sampleExpanded = _expandedSampleTables.Contains(table.Name);
                    <div class="mt-4 mb-2">
                        <MudLink Color="Color.Primary" Typo="Typo.body2" Style="font-weight:600; cursor:pointer;"
                                 OnClick="@(() => ToggleSampleTable(table.Name))">
                            <MudIcon Icon="@(sampleExpanded ? Icons.Material.Filled.ArrowDropDown : Icons.Material.Filled.ArrowRight)"
                                     Size="Size.Small" Style="vertical-align:middle;" />
                            @table.Name
                        </MudLink>
                    </div>
                    @if (sampleExpanded)
                    {
                        <MudPaper Outlined="true" Style="overflow-x:auto;">
                            <MudSimpleTable Dense="true" Elevation="0" Style="font-size:12px;">
                                <thead>
                                    <tr>
                                        @foreach (var column in table.SampleRows.Columns)
                                        {
                                            <th>@column</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in table.SampleRows.Rows)
                                    {
                                        <tr>
                                            @foreach (var value in row)
                                            {
                                                <td style="white-space:nowrap;">@TaskViewModel.FormatValue(value)</td>
                                            }
                                        </tr>
                                    }
                                </tbody>
                            </MudSimpleTable>
                        </MudPaper>
                        @if (table.SampleRows.IsTruncated)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @table.SampleRows.Rows.Count von @table.RowCount Zeilen
                            </MudText>
                        }
                    }
                }
            </div>
            }
        </div>
    </MudPaper>

    @* Bottom navigation *@
    <div class="d-flex justify-space-between align-center mt-4">
        @if (ViewModel.PreviousExerciseUrl is { } previousUrl)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@previousUrl">
                Vorherige Aufgabe
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ArrowBack" Href="@ViewModel.TaskListUrl">
                Zur Aufgabenliste
            </MudButton>
        }
        <MudText Typo="Typo.body2" Color="Color.Secondary">@ViewModel.Position / @ViewModel.TopicExerciseCount Aufgaben</MudText>
        @if (ViewModel.NextExerciseUrl is { } nextUrl)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" EndIcon="@Icons.Material.Filled.ArrowForward" Href="@nextUrl">
                Nächste Aufgabe
            </MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" EndIcon="@Icons.Material.Filled.Check" Href="@ViewModel.TaskListUrl">
                Lektion abschließen
            </MudButton>
        }
    </div>

    @* ER diagram dialog *@
    <MudDialog Visible="ViewModel.ShowErDiagram" VisibleChanged="OnErDiagramVisibleChanged"
               Options="_erDiagramOptions">
        <TitleContent>
            <MudText Typo="Typo.h6" Style="font-weight:700;">Datenmodell · @Details.DatabaseName</MudText>
        </TitleContent>
        <DialogContent>
            @if (ViewModel.ErDiagramError is not null)
            {
                <MudAlert Severity="Severity.Error">@ViewModel.ErDiagramError</MudAlert>
            }
            else if (ViewModel.ErDiagramUrl is null)
            {
                <MudProgressLinear Color="Color.Primary" Indeterminate="true" />
            }
            else
            {
                <div class="d-flex justify-center" style="max-height:75vh; overflow:auto;">
                    <img src="@ViewModel.ErDiagramUrl" alt="ER-Diagramm der Datenbank @Details.DatabaseName"
                         style="max-width:100%; height:auto; object-fit:contain;" />
                </div>
            }
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ViewModel.CloseErDiagram">Schließen</MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private readonly HashSet<string> _expandedTables = new(StringComparer.Ordinal);
    private readonly HashSet<string> _expandedSampleTables = new(StringComparer.Ordinal);
    private bool _showLeftPanel;
    private bool _showRightPanel;

    private static readonly DialogOptions _erDiagramOptions = new()
    {
        MaxWidth = MaxWidth.ExtraLarge,
        FullWidth = true,
        CloseButton = true,
        CloseOnEscapeKey = true,
        BackdropClick = true,
    };

    [Parameter]
    public string DatabaseName { get; set; } = string.Empty;

    /// <summary>Topic key from <c>aufgaben.txt</c>, e.g. "select" (any case).</summary>
    [Parameter]
    public string TaskType { get; set; } = string.Empty;

    /// <summary>Nr of the exercise in <c>aufgaben.txt</c>.</summary>
    [Parameter]
    public int TaskNr { get; set; }

    private ExerciseDetails? Details => ViewModel.Details;

    protected override Task OnParametersSetAsync() => ViewModel.LoadAsync(DatabaseName, TaskType, TaskNr);

    private void ToggleSampleTable(string table)
    {
        if (!_expandedSampleTables.Remove(table))
        {
            _expandedSampleTables.Add(table);
        }
    }

    private void ToggleTable(string table)
    {
        if (!_expandedTables.Remove(table))
        {
            _expandedTables.Add(table);
        }
    }

    private void OnErDiagramVisibleChanged(bool visible)
    {
        if (!visible)
        {
            ViewModel.CloseErDiagram();
        }
    }

    private static string DescribeColumn(TableColumn column)
    {
        var parts = new List<string> { string.IsNullOrEmpty(column.Type) ? "—" : column.Type };
        if (column.IsPrimaryKey)
        {
            parts.Add("PK");
        }
        if (column.IsForeignKey)
        {
            parts.Add("FK");
        }
        return string.Join(" · ", parts);
    }
}
